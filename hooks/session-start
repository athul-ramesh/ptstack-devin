#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");

const additionalContext = fs.readFileSync(
  path.join(__dirname, "session-start-context.md"),
  "utf8",
);

process.stdout.write(
  JSON.stringify({
    hookSpecificOutput: {
      hookEventName: "SessionStart",
      additionalContext,
    },
  }),
);
